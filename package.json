{
  "name": "vue-timeline-chart",
  "version": "5.3.3-beta.0",
  "description": "Vue3 Timeline Chart component",
  "author": "Laurens Bruijn",
  "license": "MIT",
  "homepage": "https://laurens94.github.io/vue-timeline-chart/",
  "repository": {
    "type": "git",
    "url": "https://github.com/laurens94/vue-timeline-chart.git"
  },
  "bugs": {
    "url": "https://github.com/laurens94/vue-timeline-chart/issues"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "keywords": [
    "vue",
    "vue3",
    "component",
    "timeline",
    "chart",
    "vue3-timeline-chart",
    "graph"
  ],
  "type": "module",
  "main": "./dist/vue-timeline-chart.umd.cjs",
  "module": "./dist/vue-timeline-chart.js",
  "browser": {
    "./sfc": "./src/components/Timeline.vue"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/vue-timeline-chart.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/vue-timeline-chart.umd.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite build --watch",
    "prepare": "pnpm build",
    "start": "vite",
    "build": "vite build && pnpm build:types",
    "build:types": "vue-tsc --project tsconfig.build-types.json --declaration --emitDeclarationOnly --outDir dist/types",
    "preview": "vite preview",
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.{css,vue}\"",
    "lint:fix": "pnpm lint:js:fix && pnpm lint:css:fix",
    "lint:js:fix": "eslint . --fix",
    "lint:css:fix": "stylelint \"**/*.{css,vue}\" --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run --reporter=verbose",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@shikijs/vitepress-twoslash": "^4.5.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-config": "^5.0.0",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.31",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitepress": "2.0.0-alpha.18",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
